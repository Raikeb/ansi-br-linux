// ANSI-BR - Portuguese (Brazil) tweaks for ANSI US keyboard
// Install: copy to /usr/share/X11/xkb/symbols/ansi-br (or use install script)
//
// This layout is based on US International (us(intl)) plus the extra AltGr mappings
// described in https://github.com/Raikeb/ansi-br
//
// Key idea:
// - Keep dead keys for accents (` ~ ^ ' ")
// - Add AltGr shortcuts: AltGr+`=≠, AltGr+1=¹, AltGr+a=ª, AltGr+c=ç, AltGr+/=º, etc.

default partial alphanumeric_keys
xkb_symbols "basic" {

    include "us(intl)"
    include "level3(ralt_switch)"

    name[Group1] = "Portuguese (Brazil, ANSI-BR)";

    // Number row (AltGr additions)
    key <AE01> { type="FOUR_LEVEL", symbols[Group1]=[ 1, exclam, onesuperior, exclamdown ] };
    key <AE02> { type="FOUR_LEVEL", symbols[Group1]=[ 2, at, twosuperior, exclamdown ] };
    key <AE03> { type="FOUR_LEVEL", symbols[Group1]=[ 3, numbersign, threesuperior, questiondown ] };
    key <AE04> { type="FOUR_LEVEL", symbols[Group1]=[ 4, dollar, currency, sterling ] };
    key <AE05> { type="FOUR_LEVEL", symbols[Group1]=[ 5, percent, EuroSign, NoSymbol ] };
    // Keep dead_circumflex on Shift+6, add ¼ on AltGr+6
    key <AE06> { type="FOUR_LEVEL", symbols[Group1]=[ 6, dead_circumflex, onequarter, NoSymbol ] };
    key <AE07> { type="FOUR_LEVEL", symbols[Group1]=[ 7, ampersand, onehalf, NoSymbol ] };
    key <AE08> { type="FOUR_LEVEL", symbols[Group1]=[ 8, asterisk, threequarters, NoSymbol ] };
    key <AE09> { type="FOUR_LEVEL", symbols[Group1]=[ 9, parenleft, leftsinglequotemark, NoSymbol ] };
    key <AE10> { type="FOUR_LEVEL", symbols[Group1]=[ 0, parenright, rightsinglequotemark, NoSymbol ] };
    key <AE11> { type="FOUR_LEVEL", symbols[Group1]=[ minus, underscore, yen, NoSymbol ] };
    key <AE12> { type="FOUR_LEVEL", symbols[Group1]=[ equal, plus, multiply, division ] };

    // Brackets with guillemets on AltGr
    key <AD11> { type="FOUR_LEVEL", symbols[Group1]=[ bracketleft, braceleft, guillemotleft, NoSymbol ] };
    key <AD12> { type="FOUR_LEVEL", symbols[Group1]=[ bracketright, braceright, guillemotright, NoSymbol ] };

    // Home row punctuation
    key <AC10> { type="FOUR_LEVEL", symbols[Group1]=[ semicolon, colon, paragraph, degree ] };

    // Quotes as dead keys (keep), with non-dead acute/diaeresis on AltGr
    key <AC11> { type="FOUR_LEVEL", symbols[Group1]=[ dead_acute, dead_diaeresis, acute, diaeresis ] };

    // Backtick/tilde as dead keys (keep), with ≠ on AltGr+`
    key <TLDE> { type="FOUR_LEVEL", symbols[Group1]=[ dead_grave, dead_tilde, notequal, NoSymbol ] };

    // Backslash key with ¬ and ¦ on AltGr
    key <BKSL> { type="FOUR_LEVEL", symbols[Group1]=[ backslash, bar, notsign, brokenbar ] };

    // Bottom row punctuation
    key <AB08> { type="FOUR_LEVEL", symbols[Group1]=[ comma, less, copyright, cent ] };
    key <AB10> { type="FOUR_LEVEL", symbols[Group1]=[ slash, question, masculine, questiondown ] };

    // Space with NBSP on AltGr+Space
    key <SPCE> { type="FOUR_LEVEL", symbols[Group1]=[ space, space, nobreakspace, NoSymbol ] };

    // Letters (AltGr additions)
    key <AD01> { type="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ q, Q, adiaeresis, Adiaeresis ] };
    key <AD02> { type="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ w, W, aring, Aring ] };
    key <AD03> { type="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ e, E, eacute, Eacute ] };
    key <AD04> { type="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ r, R, registered, NoSymbol ] };
    key <AD05> { type="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ t, T, thorn, THORN ] };
    key <AD06> { type="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ y, Y, udiaeresis, Udiaeresis ] };
    key <AD07> { type="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ u, U, uacute, Uacute ] };
    key <AD08> { type="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ i, I, iacute, Iacute ] };
    key <AD09> { type="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ o, O, oacute, Oacute ] };
    key <AD10> { type="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ p, P, odiaeresis, Odiaeresis ] };

    key <AC01> { type="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ a, A, feminine, Aacute ] };
    key <AC02> { type="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ s, S, ssharp, section ] };
    key <AC03> { type="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ d, D, eth, ETH ] };
    // F/G/H/J/K: keep default from us(intl)
    key <AC09> { type="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ l, L, oslash, Oslash ] };

    key <AB01> { type="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ z, Z, ae, AE ] };
    key <AB03> { type="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ c, C, ccedilla, Ccedilla ] };
    key <AB06> { type="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ n, N, ntilde, Ntilde ] };
    key <AB07> { type="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ m, M, mu, NoSymbol ] };

};
